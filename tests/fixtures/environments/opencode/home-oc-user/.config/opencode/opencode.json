{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "docs-server": {
      "type": "local",
      "command": ["node", "./server.js"],
      "enabled": true
    },
    "remote-search": {
      "type": "remote",
      "url": "https://mcp.example.invalid/mcp",
      "headers": { "Authorization": "Bearer ghp_ZZZZfaultyfaketoken000000" }
    },
    "disabled-thing": {
      "type": "local",
      "command": ["echo"],
      "enabled": false
    }
  },
  "agent": {
    "docs-search": {
      "description": "Searches project documentation on demand",
      "mode": "subagent"
    }
  },
  "plugin": ["opencode-wakatime"],
  "instructions": ["AGENTS.md", ".cursor/rules/*.md"],
  "permission": {
    "edit": "ask"
  }
}
