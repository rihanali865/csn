{
  "name": "capability-swarm-network",
  "version": "0.1.0",
  "private": true,
  "description": "Capability Swarm Network (CSN) — audit AI coding environments, manage capability compatibility, and exchange privacy-preserving capability reports with a private Master Agent.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit": "tsx apps/cli/src/index.ts audit",
    "dashboard": "tsx apps/dashboard/src/server.ts",
    "api": "tsx services/api/src/server.ts",
    "master": "tsx services/master-agent/src/cli.ts"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
